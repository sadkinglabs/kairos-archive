---
/** What the registry knows about a record that the official API does not
 * say, each fact with where it came from and when it was written down.
 * A note is a report, not an official record, so its source is always
 * shown with it, set apart in a box of its own. Renders nothing when there
 * are none. */
import type { Note } from '../data/registry';
interface Props { notes?: Note[] }
const { notes = [] } = Astro.props;
---
{notes.length > 0 && <section class="notice notes" aria-labelledby="notes-heading">
  <h2 id="notes-heading" class="eyebrow muted">{notes.length === 1 ? 'Note' : 'Notes'}</h2>
  <ul>{notes.map(n => <li><p>{n.text}</p><p class="note-source">Source: {n.source} <span aria-hidden="true">·</span> recorded {n.recorded}</p></li>)}</ul>
</section>}
