---
/** The record block: what this thing is called, and every way out of the
 * page - the site's JSON both ways round, and the publisher's own record
 * where there is one. One component so a card, a printing and a set all
 * offer the same block in the same place.
 *
 * Without any links it is a bare centred identifier line rather than an
 * empty panel (the printing page names its card that way). */
import Icon from './Icon.astro';
interface Props {
  id?: string | null; url?: string | null; label?: string; official?: string | null;
  /** The record this one belongs to (a printing's card): its id and page, on a second line. */
  parent?: { label: string; id: string; href: string; text: string } | null;
}
const { id, url, label = 'Codex ID', official, parent = null } = Astro.props;
const links = Boolean(url || official);
---
<div class:list={['record-block', { bare: !links }]}>
  {id && <p class="record-id"><span class="muted">{label}</span> <code>{id}</code> <button class="copy" data-copy={id} aria-label={`Copy ${label} ${id}`}>Copy</button></p>}
  {links && <div class="record-buttons">
    {url && <a class="btn secondary" href={url}>Show JSON</a>}
    {url && <a class="btn secondary" href={url} data-download={id ?? url.split('/').pop()?.replace(/\.json$/, '') ?? 'record'}><Icon name="download" size={16} /> Download JSON</a>}
    {official && <a class="btn secondary" href={official}>SorceryTCG.com <Icon name="external" size={15} /></a>}
  </div>}
  {parent && <p class="record-id parent"><span class="muted">{parent.label}</span> <code>{parent.id}</code> <button class="copy" data-copy={parent.id} aria-label={`Copy ${parent.label} ${parent.id}`}>Copy</button> <a href={parent.href}>{parent.text}</a></p>}
</div>
