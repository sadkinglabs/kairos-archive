---
/** What a printing says against what the card says now: the face in
 * force on the printing's release date, diffed with the current face,
 * plus the name if that changed too. One component, so the card page's
 * fold and the printing page's section show the same comparison. */
import { changedFields, historySource, rowInForce, type RegistryCard, type RegistryPrinting, type HistoryRow } from '../data/registry';
import FaceDiff from './FaceDiff.astro';
import ValueDiff from './ValueDiff.astro';
interface Props { printing: RegistryPrinting; card: RegistryCard; history: HistoryRow[]; names: { name: string; valid_from: string; valid_to: string | null }[] }
const { printing: p, card, history, names } = Astro.props;
// A printing that shows older values was printed with the face in force on
// its release date - unless it is a reprint that kept the old face after the
// change (data/errata.json's outdated_printings), whose date falls in the
// current row: then it shows the newest face before the current one.
const inForce = p.printed_as_current === false && p.released_at ? rowInForce(history, p.released_at) : null;
const earlier = [...history].filter(r => r.valid_to !== null).sort((a, b) => a.valid_from.localeCompare(b.valid_from)).at(-1) ?? null;
const row = inForce && inForce.valid_to === null ? earlier : inForce;
const nameRow = p.released_at ? rowInForce(names, p.released_at) : null;
const nameChanged = Boolean(nameRow && nameRow.name !== card.name);
---
{row && <div class="as-printed-body">
  <p class="source-note">{historySource(row).label} · {historySource(row).dated} {row.valid_from}{row.valid_to && ` · range ends ${row.valid_to}`}</p>
  {nameChanged && <ValueDiff field="name" before={nameRow!.name} after={card.name} beforeLabel="Printed name" afterLabel="Current name" />}
  <FaceDiff before={row} after={card} beforeLabel="Printed values" afterLabel="Current values" />
  {changedFields(row.back, card.back).length > 0 && <><h4>Back face</h4><FaceDiff before={row.back} after={card.back} beforeLabel="Printed values" afterLabel="Current values" /></>}
</div>}
