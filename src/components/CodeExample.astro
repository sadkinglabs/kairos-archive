---
/** A code sample with a Copy button, coloured by Shiki at build time.
 * Shiki writes each token's colour as an inline style, which is why the
 * site's Content-Security-Policy allows inline styles (public/_headers).
 * Both themes' colours ride on every token as variables; global.css
 * picks one by the colour scheme, so no script and no second render. */
import { Code } from 'astro:components';
import type { BundledLanguage } from 'shiki';
interface Props { code: string; lang?: string; title?: string }
const { code, lang = 'text', title = 'Example' } = Astro.props;
---
<div class="code-example"><div class="section-heading"><span class="source-note">{title}</span><button class="copy" data-copy={code} aria-label={`Copy ${title}`}>Copy</button></div><Code code={code} lang={lang as BundledLanguage} themes={{ light: 'vitesse-light', dark: 'vitesse-dark' }} defaultColor={false} class="code-block" /></div>
