---
import "../styles/global.css";
import { loadRegistry } from "../data/registry";
interface Props { title: string; description?: string; canonical?: string; image?: string | null }
const { title, description = "Search, card pages and full history for Sorcery: Contested Realm, built on the Sorcery Card Registry.", canonical, image } = Astro.props;
const { source } = await loadRegistry();
const pageTitle = title === "Kairos Archive" ? title : `${title} · Kairos Archive`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={new URL(canonical, Astro.site)} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image ?? new URL("/brand/og.png", Astro.site)} />
    <meta property="og:site_name" content="Kairos Archive" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/brand/icon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/brand/icon-180.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <header class="site">
      <div class="inner">
        <a class="brand" href="/" aria-label="Kairos Archive, home">
          <picture>
            <source srcset="/brand/wordmark-dark-560.png" media="(prefers-color-scheme: dark)" />
            <img src="/brand/wordmark-560.png" alt="Kairos Archive" width="560" height="233" />
          </picture>
        </a>
        <form action="/search" method="get" role="search">
          <input type="search" name="q" id="site-search" placeholder='search cards: "polar bears", t:minion e:water, r:genesis' aria-label="Search" />
          <button type="submit">Search</button>
        </form>
        <nav>
          <a href="/sets">Sets</a><a href="/tokens">Tokens</a><a href="/changes">Changes</a><a href="/syntax">Syntax</a><a href="/about">About</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site">
      <div class="inner">
        Card names, text and images © <a href="https://sorcerytcg.com">Erik's Curiosa</a>, shown with credit for archive, identification and site function.
        Identifiers, structure and history: Kairos Archive, free for any use (<a href="/usage">usage</a>).
        Data: <a href="https://api.kairosarchive.net/versions.json">Sorcery Card Registry</a> release <code>{source.tag}</code> ·
        <a href="https://github.com/sadkinglabs/sorcery-registry">registry source</a> · <a href="https://github.com/sadkinglabs/kairos-archive">site source</a>
      </div>
    </footer>
    <script>
      import { suggest, type NameEntry } from "../search/suggest";

      type Suggestion = NameEntry & { type: string | null };

      // A query using the site's own syntax (a key:, a quoted phrase, a
      // comparison) is not a bare name, so name autocomplete stays out
      // of its way and shows nothing.
      const NO_SUGGEST = /[:"<>=!]/;
      const escapeHtml = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);

      let namesPromise: Promise<Suggestion[]> | null = null;
      function loadNames(): Promise<Suggestion[]> {
        namesPromise ??= fetch("/data/names.json").then((r) => r.json());
        return namesPromise;
      }

      function enhance(input: HTMLInputElement) {
        const wrap = document.createElement("div");
        wrap.className = "suggest-wrap";
        input.replaceWith(wrap);
        wrap.appendChild(input);

        const list = document.createElement("ul");
        const listId = `suggest-${Math.random().toString(36).slice(2)}`;
        list.className = "suggest-list";
        list.id = listId;
        list.setAttribute("role", "listbox");
        list.hidden = true;
        wrap.appendChild(list);

        input.setAttribute("role", "combobox");
        input.setAttribute("aria-autocomplete", "list");
        input.setAttribute("aria-expanded", "false");
        input.setAttribute("aria-controls", listId);
        input.setAttribute("autocomplete", "off");

        let matches: Suggestion[] = [];
        let active = -1;
        let closeTimer: ReturnType<typeof setTimeout> | undefined;

        function close() {
          list.hidden = true;
          list.innerHTML = "";
          matches = [];
          active = -1;
          input.setAttribute("aria-expanded", "false");
          input.removeAttribute("aria-activedescendant");
        }

        function highlight(index: number) {
          active = index;
          const options = list.querySelectorAll("li");
          options.forEach((o, i) => o.classList.toggle("active", i === index));
          if (index >= 0 && options[index]) {
            input.setAttribute("aria-activedescendant", options[index].id);
            options[index].scrollIntoView({ block: "nearest" });
          } else {
            input.removeAttribute("aria-activedescendant");
          }
        }

        function go(item: Suggestion) {
          location.href = item.path;
        }

        function render(items: Suggestion[]) {
          matches = items;
          active = -1;
          if (items.length === 0) { close(); return; }
          list.hidden = false;
          input.setAttribute("aria-expanded", "true");
          list.innerHTML = items.map((item, i) =>
            `<li role="option" id="${listId}-${i}"><span class="name">${escapeHtml(item.name)}</span>${item.type ? `<span class="type">${escapeHtml(item.type)}</span>` : ""}</li>`
          ).join("");
          list.querySelectorAll("li").forEach((li, i) => li.addEventListener("click", () => go(items[i])));
        }

        async function onInput() {
          const raw = input.value;
          const q = raw.trim();
          if (!q || NO_SUGGEST.test(raw)) { close(); return; }
          const names = await loadNames();
          if (input.value.trim() !== q) return; // input changed while the fetch was in flight
          render(suggest(names, q, 8));
        }

        input.addEventListener("focus", () => {
          void loadNames();
          if (closeTimer) { clearTimeout(closeTimer); closeTimer = undefined; }
        });
        input.addEventListener("input", () => void onInput());
        input.addEventListener("keydown", (e) => {
          if (e.key === "Escape") { close(); return; }
          if (list.hidden || matches.length === 0) return;
          if (e.key === "ArrowDown") { e.preventDefault(); highlight(active + 1 >= matches.length ? 0 : active + 1); }
          else if (e.key === "ArrowUp") { e.preventDefault(); highlight(active - 1 < 0 ? matches.length - 1 : active - 1); }
          else if (e.key === "Enter" && active >= 0) { e.preventDefault(); go(matches[active]); }
          // Enter with nothing highlighted falls through and submits the form, as before.
        });
        // A blur fires before a click on a suggestion is handled, so the
        // list closes on a short delay instead of immediately.
        input.addEventListener("blur", () => { closeTimer = setTimeout(close, 150); });
      }

      document.querySelectorAll<HTMLInputElement>('input[type="search"][name="q"]').forEach(enhance);

      // "/" anywhere on the site jumps to the header search box, unless
      // the user is already typing somewhere (another input, a select, a
      // contenteditable region) - then "/" should just type a slash.
      // Escape in the box blurs it, so a second "/" reopens it fresh.
      const search = document.getElementById("site-search") as HTMLInputElement | null;
      document.addEventListener("keydown", (event) => {
        if (event.key !== "/" || !search) return;
        const target = event.target as HTMLElement | null;
        const typing = target && (target.tagName === "INPUT" || target.tagName === "TEXTAREA" || target.tagName === "SELECT" || target.isContentEditable);
        if (typing) return;
        event.preventDefault();
        search.focus();
        search.select();
      });
      search?.addEventListener("keydown", (event) => {
        if (event.key === "Escape") search.blur();
      });
    </script>
  </body>
</html>
