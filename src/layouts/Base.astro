---
import "../styles/global.css";
import SearchBox from "../components/SearchBox.astro";
import { loadRegistry } from "../data/registry";
import { pagePath } from "../presentation/pagePath";
interface Props {
  title: string; description?: string; canonical?: string; image?: string | null;
  /** What a link unfurls to in Discord and the like: several lines; falls back to description. */
  embed?: string;
  /** The bar down the side of the unfurled link (theme-color). */
  colour?: string;
}
const { title, description = "Search, card pages and full history for Sorcery: Contested Realm, built on the Sorcery Card Registry.", canonical, image, embed, colour } = Astro.props;
const { source } = await loadRegistry();
const here = pagePath(Astro.url.pathname);
const isHome = here === "/";
// Three groups, ruled apart: what the archive holds, what changed in it,
// and how to read it.
const menu: [string, string][][] = [
  [["/sets", "Sets"], ["/cards", "All Cards"], ["/tokens", "Tokens"]],
  [["/changes", "Changes & Errata"]],
  [["/syntax", "Search Syntax"], ["/docs", "API Docs"], ["/docs/data", "Download the Data"], ["/fun", "Fun Zone"], ["/about", "About"]],
];
const pageTitle = title === "Kairos Archive" ? title : `${title} · Kairos Archive`;
/** Cloudflare Web Analytics (page views, referrers; no cookies, no
 * identifiers), only when the zone's token is set at build time. */
const beaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN as string | undefined;
/** Where outbound clicks are counted (stats Worker, POST /event). */
const statsBase = (import.meta.env.PUBLIC_STATS_BASE_URL as string | undefined) ?? "https://stats.kairosarchive.net";
/** The footer's site map: every way around the archive, in four groups. */
const footerGroups: [string, [string, string][]][] = [
  ["Cards", [["/advanced", "Advanced Search"], ["/syntax", "Search Syntax"], ["/sets", "All Sets"], ["/cards", "All Cards"], ["/tokens", "Tokens"], ["/random", "Random Card"]]],
  ["Kairos Archive", [["/changes", "Changes & Errata"], ["/discord", "Discord Bot"], ["/fun", "Fun Zone"], ["/about", "About"]]],
  ["Developers", [["/docs", "API Documentation"], ["/docs/data", "Download the Data"], ["/docs/types/card", "Card Object"], ["/docs/changelog", "API Changelog"], ["/usage", "Usage & Attribution"]]],
  ["Source", [["https://github.com/sadkinglabs/sorcery-registry", "Registry on GitHub"], ["https://github.com/sadkinglabs/kairos-archive", "Site on GitHub"], ["https://github.com/sadkinglabs/sorcery-registry/issues", "Report an Issue"]]],
];
---
<!doctype html>
<html lang="en" data-stats={statsBase}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={new URL(canonical, Astro.site)} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={embed ?? description} />
    {colour && <meta name="theme-color" content={colour} />}
    <meta property="og:image" content={image ?? new URL("/brand/og.png", Astro.site)} />
    <meta property="og:site_name" content="Kairos Archive" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/brand/icon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/brand/icon-180.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {beaconToken && <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: beaconToken })}></script>}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site">
      <div class="inner">
        <a class="brand" href="/" aria-label="Kairos Archive, home">
          <img src="/brand/mark.png" alt="" width="48" height="48" />
          <span>Kairos Archive</span>
        </a>
        <details class="site-menu">
          <summary aria-label="Navigation menu"><span class="menu-lines" aria-hidden="true"></span><span class="sr-only">Menu</span></summary>
          <nav aria-label="Main navigation">{menu.map((group, i) => <>
            {i > 0 && <hr />}
            {group.map(([href, label]) => <a href={href} aria-current={here === href || here.startsWith(`${href}/`) ? 'page' : undefined}>{label}</a>)}
          </>)}</nav>
        </details>
        {!isHome && <SearchBox />}
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site">
      <div class="inner">
        <nav class="footer-groups" aria-label="Site map">{footerGroups.map(([group, links]) => <div><h2>{group}</h2>{links.map(([href, label]) => <a href={href}>{label}</a>)}</div>)}</nav>
        <p class="credit">Card names, text and images © <a href="https://sorcerytcg.com">Erik's Curiosa</a>, shown with credit for archive, identification and site function.
        Identifiers, structure and history: Kairos Archive, free for any use (<a href="/usage">usage</a>).
        Data: <a href="https://api.kairosarchive.net/versions.json">Sorcery Card Registry</a> release <code>{source.tag}</code> · <a href="https://github.com/sadkinglabs/sorcery-registry">registry source</a> · <a href="https://github.com/sadkinglabs/kairos-archive">site source</a></p>
      </div>
    </footer>
    <script>
      import { suggest, type NameEntry } from "../search/suggest";

      // The navigation menu and the search box's syntax help are both
      // <details> popovers: Escape closes the open one, and so does a click
      // anywhere outside it.
      const popovers = Array.from(document.querySelectorAll<HTMLDetailsElement>('details.site-menu, details.syntax-help'));
      document.addEventListener('keydown', event => {
        if (event.key !== 'Escape') return;
        for (const popover of popovers) if (popover.open) { popover.open = false; popover.querySelector('summary')?.focus(); }
      });
      document.addEventListener('click', event => {
        for (const popover of popovers) {
          if (popover.open && event.target instanceof Node && !popover.contains(event.target)) popover.open = false;
        }
      });
      // Two things are counted: outbound clicks (the host the link goes to,
      // the page it was on, and the link's data-track label when it has
      // one) and searches (the keys used, how many results; never the words
      // typed). Nothing about who. A text/plain body keeps the beacon a simple request, so no
      // preflight. Pages report a search by dispatching kairos:stat.
      const statsBase = document.documentElement.dataset.stats;
      const send = (detail: unknown) => {
        if (!statsBase) return;
        try { navigator.sendBeacon(`${statsBase}/event`, new Blob([JSON.stringify(detail)], { type: 'text/plain' })); } catch { /* counting is never the page's problem */ }
      };
      document.addEventListener('kairos:stat', event => { if (event instanceof CustomEvent) send(event.detail); });
      document.addEventListener('click', event => {
        if (!statsBase || !(event.target instanceof Element)) return;
        const link = event.target.closest('a[href]');
        if (!(link instanceof HTMLAnchorElement)) return;
        let target: URL;
        try { target = new URL(link.href, location.href); } catch { return; }
        if (target.host === location.host || !/^https?:$/.test(target.protocol)) return;
        send({ h: target.host.slice(0, 80), p: location.pathname.slice(0, 120), t: (link.dataset.track ?? '').slice(0, 40) });
      });
      document.querySelectorAll<HTMLImageElement>('img.card-img').forEach(image => {
        const fallback = () => {
          const placeholder = document.createElement('div');
          placeholder.className = 'placeholder';
          placeholder.textContent = 'Image unavailable';
          image.replaceWith(placeholder);
        };
        image.addEventListener('error', fallback, { once: true });
        if (image.complete && image.naturalWidth === 0) fallback();
      });
      // Shared actions work on card, printing, set and documentation pages.
      document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach(button => {
        button.addEventListener("click", async () => {
          const original = button.textContent;
          try { await navigator.clipboard.writeText(button.dataset.copy ?? ""); button.textContent = "Copied"; }
          catch { button.textContent = "Select to copy"; }
          setTimeout(() => { button.textContent = original; }, 1600);
        });
      });
      document.querySelectorAll<HTMLAnchorElement>("[data-download]").forEach(link => {
        link.addEventListener("click", async event => {
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          event.preventDefault();
          if (link.getAttribute("aria-busy") === "true") return;
          link.setAttribute("aria-busy", "true");
          const status = document.createElement("span");
          status.setAttribute("role", "status");
          status.className = "download-status muted";
          link.parentElement?.querySelector(".download-status")?.remove();
          link.after(status);
          try {
            const response = await fetch(link.href);
            if (!response.ok) throw new Error(`HTTP ${response.status}`);
            const blob = await response.blob();
            const url = URL.createObjectURL(blob);
            const download = document.createElement("a");
            download.href = url; download.download = `${link.dataset.download}.json`;
            document.body.append(download); download.click(); download.remove();
            setTimeout(() => URL.revokeObjectURL(url), 1000);
            status.textContent = "Downloaded";
          } catch { status.textContent = "Download unavailable. Use View JSON to open the source."; }
          finally { link.removeAttribute("aria-busy"); }
        });
      });

      type Suggestion = NameEntry & { type: string | null };

      // A query using the site's own syntax (a key:, a quoted phrase, a
      // comparison) is not a bare name, so name autocomplete stays out
      // of its way and shows nothing.
      const NO_SUGGEST = /[:"<>=!]/;
      const escapeHtml = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);

      let namesPromise: Promise<Suggestion[]> | null = null;
      function loadNames(): Promise<Suggestion[]> {
        namesPromise ??= fetch("/data/names.json").then((r) => { if (!r.ok) throw new Error("Names unavailable"); return r.json(); }).catch(error => { namesPromise = null; throw error; });
        return namesPromise;
      }

      function enhance(input: HTMLInputElement) {
        const wrap = document.createElement("div");
        wrap.className = "suggest-wrap";
        input.replaceWith(wrap);
        wrap.appendChild(input);

        const list = document.createElement("ul");
        const listId = `suggest-${Math.random().toString(36).slice(2)}`;
        list.className = "suggest-list";
        list.id = listId;
        list.setAttribute("role", "listbox");
        list.hidden = true;
        wrap.appendChild(list);

        input.setAttribute("role", "combobox");
        input.setAttribute("aria-autocomplete", "list");
        input.setAttribute("aria-expanded", "false");
        input.setAttribute("aria-controls", listId);
        input.setAttribute("autocomplete", "off");

        let matches: Suggestion[] = [];
        let active = -1;
        let closeTimer: ReturnType<typeof setTimeout> | undefined;

        function close() {
          list.hidden = true;
          list.innerHTML = "";
          matches = [];
          active = -1;
          input.setAttribute("aria-expanded", "false");
          input.removeAttribute("aria-activedescendant");
        }

        function highlight(index: number) {
          active = index;
          const options = list.querySelectorAll("li");
          options.forEach((o, i) => { o.classList.toggle("active", i === index); o.setAttribute("aria-selected", String(i === index)); });
          if (index >= 0 && options[index]) {
            input.setAttribute("aria-activedescendant", options[index].id);
            options[index].scrollIntoView({ block: "nearest" });
          } else {
            input.removeAttribute("aria-activedescendant");
          }
        }

        function go(item: Suggestion) {
          location.href = item.path;
        }

        function render(items: Suggestion[]) {
          matches = items;
          active = -1;
          if (items.length === 0) { close(); return; }
          list.hidden = false;
          input.setAttribute("aria-expanded", "true");
          list.innerHTML = items.map((item, i) =>
            `<li role="option" aria-selected="false" id="${listId}-${i}"><span class="name">${escapeHtml(item.name)}</span>${item.type ? `<span class="type">${escapeHtml(item.type)}</span>` : ""}</li>`
          ).join("");
          list.querySelectorAll("li").forEach((li, i) => li.addEventListener("click", () => go(items[i])));
        }

        async function onInput() {
          const raw = input.value;
          const q = raw.trim();
          if (!q || NO_SUGGEST.test(raw)) { close(); return; }
          try {
            const names = await loadNames();
            if (input.value.trim() !== q || document.activeElement !== input) return;
            render(suggest(names, q, 8));
          } catch { close(); } // Plain search still works if autocomplete is unavailable.
        }

        input.addEventListener("focus", () => {
          if (closeTimer) { clearTimeout(closeTimer); closeTimer = undefined; }
        });
        input.addEventListener("input", () => void onInput());
        // Search results can update in place, so submission must close the
        // suggestions even when the browser does not navigate to a new page.
        input.form?.addEventListener("submit", close);
        input.addEventListener("keydown", (e) => {
          if (e.key === "Escape") { close(); return; }
          if (list.hidden || matches.length === 0) return;
          if (e.key === "ArrowDown") { e.preventDefault(); highlight(active + 1 >= matches.length ? 0 : active + 1); }
          else if (e.key === "ArrowUp") { e.preventDefault(); highlight(active - 1 < 0 ? matches.length - 1 : active - 1); }
          else if (e.key === "Enter" && active >= 0) { e.preventDefault(); go(matches[active]); }
          // Enter with nothing highlighted falls through and submits the form, as before.
        });
        // A blur fires before a click on a suggestion is handled, so the
        // list closes on a short delay instead of immediately.
        input.addEventListener("blur", () => { closeTimer = setTimeout(close, 150); });
      }

      document.querySelectorAll<HTMLInputElement>('input[type="search"][name="q"]').forEach(enhance);

      // "/" anywhere on the site jumps to the header search box, unless
      // the user is already typing somewhere (another input, a select, a
      // contenteditable region) - then "/" should just type a slash.
      // Escape in the box blurs it, so a second "/" reopens it fresh.
      const search = document.getElementById("site-search") as HTMLInputElement | null;
      document.addEventListener("keydown", (event) => {
        if (event.key !== "/" || !search) return;
        const target = event.target as HTMLElement | null;
        const typing = target && (target.tagName === "INPUT" || target.tagName === "TEXTAREA" || target.tagName === "SELECT" || target.isContentEditable);
        if (typing) return;
        event.preventDefault();
        search.focus();
        search.select();
      });
      search?.addEventListener("keydown", (event) => {
        if (event.key === "Escape") search.blur();
      });
    </script>
  </body>
</html>
