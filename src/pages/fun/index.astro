---
/** The Fun Zone: small things built on the archive's public tools, each
 * with its source on the page. Proof that the tools are enough, and a
 * starting point for the next person. */
import Base from "../../layouts/Base.astro";
const projects = [
  { href: "/fun/random-deck", title: "Random Deck Generator", detail: "A simple Random Deck Generator, using the query API in JavaScript.", uses: "query API" },
  { href: "/fun/set-analyser", title: "Set Analyser", detail: "Fetch a whole set data once and turn the records into insight. Compare two sets side by side.", uses: "query API" },
];
---
<Base title="Fun Zone" canonical="/fun" description="Small projects made with Kairos Archive's public tools, with easy to follow tutorials you can try yourself.">
  <h1>Fun Zone</h1>
  <p class="intro">Welcome to the Fun Zone. A collection of small projects made with the archive's public tools, accompanied by easy to follow tutorials you can try yourself.</p>

  <ul class="projects">
    {projects.map((p) => (
      <li>
        <a href={p.href}><strong>{p.title}</strong></a>
        <p>{p.detail}</p>
        <p class="muted uses">Uses: {p.uses}</p>
      </li>
    ))}
  </ul>

  <h2>Built something?</h2>
  <p>If you have built a fun project using the Kairos Archive API, let us know! We would love to hear about the interesting and creative ways people are interacting with The Realm using our free tools. Open an issue or a pull request on the <a href="https://github.com/sadkinglabs/kairos-archive">site's repository</a>.</p>
</Base>

<style>
  .projects { list-style: none; padding: 0; margin: 1.5rem 0; display: grid; gap: 1rem; }
  .projects li { border: 1px solid var(--line); background: var(--card); border-radius: 8px; padding: 1rem 1.2rem; }
  .projects li a { font-size: 1.25rem; text-decoration: none; }
  .projects li a:hover { text-decoration: underline; }
  .projects li p { margin: .4rem 0 0; }
  .uses { font-size: .85rem; }
</style>
