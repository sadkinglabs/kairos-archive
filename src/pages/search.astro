---
import Base from "../layouts/Base.astro";
import CardBrowser from "../components/CardBrowser.astro";

/** The fallback head, for the rare unfurl the preview Function cannot
 * answer: an empty search box, or the query API not replying in time.
 *
 * It says what the page is and stops. It must never print an example
 * query: an unfurl sits directly under the URL the person pasted, so a
 * query in the description reads as the query they searched for, and
 * being confidently wrong about that is worse than saying little. */
---
<Base title="Search" canonical="/search"
  description="Search every Sorcery: Contested Realm card by rules text, element, cost, keyword, set and artist."
  embed="Search every card in the archive by rules text, element, cost, keyword, set and artist.">
  <CardBrowser heading="Search" />
</Base>
