---
import Base from "../layouts/Base.astro";
import CardBrowser from "../components/CardBrowser.astro";

/** The head a link unfurler reads. The page is one file for every query
 * - the query is read and answered in the browser - so what a scraper
 * sees cannot name the query or the cards it found.
 *
 * It must therefore not print an example query either. An unfurl sits
 * directly under the URL the person pasted, so a query in the
 * description reads as the query they searched for, and being
 * confidently wrong about that is worse than saying little. */
---
<Base title="Search" canonical="/search"
  description="Search every Sorcery: Contested Realm card by rules text, element, cost, keyword, set and artist."
  embed="Search every card in the archive by rules text, element, cost, keyword, set and artist.">
  <CardBrowser heading="Search" />
</Base>
