---
/** A door, not a page - and the fallback one. In production the Pages
 * Function at functions/random.ts claims /random first and answers with a
 * 302; this page serves only if that fails, and is what `astro build`
 * verifies either way.
 *
 * The pick here is in the browser, but nothing about it needs the network:
 * the 1,100 card paths are written into the page at build time and the
 * redirect runs from <head>, before the body is parsed, so the browser
 * goes straight to the card. replace(), not assign(), so Back returns
 * where you came from rather than rolling again. */
import Base from '../layouts/Base.astro';
import { loadRegistry, cardPath } from '../data/registry';
const { registry } = await loadRegistry();
const paths = registry.cards.map(cardPath);
if (paths.length === 0) throw new Error('/random has no cards to choose from.');
---
<Base title="Random card" canonical="/random" noindex
      description="Open a card from the archive at random.">
  <script slot="head" is:inline define:vars={{ paths }}>
    location.replace(paths[Math.floor(Math.random() * paths.length)]);
  </script>
  <div class="waiting">
    <h1>Finding a card…</h1>
    <noscript><p class="muted">A random card needs JavaScript, because the pick happens in your browser. <a href="/cards">Browse all {registry.header.cards.toLocaleString('en')} cards</a> instead.</p></noscript>
  </div>
</Base>
