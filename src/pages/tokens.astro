---
import Base from "../layouts/Base.astro";
import CardTile from "../components/CardTile.astro";
import { loadRegistry, orderedSets, setPath, views } from "../data/registry";

// Tokens aren't a set of their own upstream, so give them a catalogue page
// like /sets: every card whose category is Token, grouped by the set of
// its default printing (falling back to "no printing on record" for the
// rare token with none).
const { registry } = await loadRegistry();
const v = views(registry);
const tokens = registry.cards.filter((c) => c.category === "Token");

interface Group { set: typeof registry.sets[number] | null; cards: typeof tokens }
const groups = new Map<string, Group>();
for (const card of tokens) {
  const printing = card.default_printing_id ? v.printingById.get(card.default_printing_id) : undefined;
  const set = printing ? (registry.sets.find((s) => s.set_code === printing.set_code) ?? null) : null;
  const key = set?.set_code ?? "none";
  if (!groups.has(key)) groups.set(key, { set, cards: [] });
  groups.get(key)!.cards.push(card);
}
// Set order, so the promo bucket lands last here too; a token with no
// printing on record has no set and goes after them.
const order = new Map(orderedSets(registry.sets).map((s, i) => [s.set_code ?? "none", i]));
const sorted = [...groups.values()].sort((a, b) =>
  (order.get(a.set?.set_code ?? "none") ?? 999) - (order.get(b.set?.set_code ?? "none") ?? 999));
for (const g of sorted) g.cards.sort((a, b) => a.name.localeCompare(b.name));
---
<Base title="Tokens" canonical="/tokens">
  <h1>Tokens</h1>
  <p class="muted">{tokens.length} token cards, grouped by the set of their default printing. <a href="/search?q=cat%3Atoken">Every token as a search</a>.</p>
  {sorted.map((g) => (
    <section>
      <h2>{g.set ? <a href={setPath(g.set)}>{g.set.set_name}</a> : "No printing on record"} {g.set && <span class="muted">· {g.set.set_code}</span>}</h2>
      <div class="grid">{g.cards.map((c) => <CardTile card={c} printing={c.default_printing_id ? (v.printingById.get(c.default_printing_id) ?? null) : null} />)}</div>
    </section>
  ))}
</Base>
