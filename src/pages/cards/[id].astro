---
import { cardPath, loadRegistry } from "../../data/registry";
export async function getStaticPaths() {
  const { registry } = await loadRegistry();
  return registry.cards.map((card) => ({ params: { id: card.codex_id }, props: { to: cardPath(card), name: card.name } }));
}
const { to, name } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="utf-8" /><title>{name}</title><meta http-equiv="refresh" content={`0; url=${to}`} /><link rel="canonical" href={new URL(to, Astro.site)} /></head>
<body><p>Redirecting to <a href={to}>{name}</a>.</p></body></html>
