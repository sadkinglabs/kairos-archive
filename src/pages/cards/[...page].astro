---
/** Every card, alphabetically, in pages - the browsable index behind the
 * menu's "Cards". Search answers a question; this answers "show me what is
 * in here". Paginated statically because 1,100 tiles in one document is a
 * lot of markup and a lot of images for a phone, and the A-Z bar makes the
 * pages navigable without clicking through them one at a time. */
import type { GetStaticPaths, Page } from 'astro';
import Base from '../../layouts/Base.astro';
import CardTile from '../../components/CardTile.astro';
import { loadRegistry, views, type RegistryCard } from '../../data/registry';
// The same page as a page of search results, so "a page" means one thing
// on this site. getStaticPaths is hoisted and cannot see this file's own
// consts, which is why it comes from a module rather than a line above.
import { PAGE_SIZE } from '../../search/paginate';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const { registry } = await loadRegistry();
  const cards = [...registry.cards].sort((a, b) => a.name.localeCompare(b.name));
  return paginate(cards, { pageSize: PAGE_SIZE });
};

const { page } = Astro.props as { page: Page<RegistryCard> };
const { registry } = await loadRegistry();
const v = views(registry);
const printingOf = (c: RegistryCard) =>
  c.default_printing_id ? (v.printingById.get(c.default_printing_id) ?? null) : null;

/** The first page each initial letter appears on, so the A-Z bar can jump
 * straight to it. A name that starts with anything else (a digit, a quote)
 * files under #. */
const sorted = [...registry.cards].sort((a, b) => a.name.localeCompare(b.name));
const initial = (name: string) => {
  const c = name[0]?.toUpperCase() ?? '#';
  return c >= 'A' && c <= 'Z' ? c : '#';
};
const pageOf = new Map<string, number>();
sorted.forEach((card, index) => {
  const letter = initial(card.name);
  if (!pageOf.has(letter)) pageOf.set(letter, Math.floor(index / PAGE_SIZE) + 1);
});
const letters = [...pageOf.entries()].sort(([a], [b]) => a.localeCompare(b));
const href = (n: number) => (n === 1 ? '/cards' : `/cards/${n}`);
const firstOnPage = initial(page.data[0].name);
const lastOnPage = initial(page.data[page.data.length - 1].name);
---
<Base title={page.currentPage === 1 ? 'All cards' : `All cards, page ${page.currentPage}`}
      canonical={href(page.currentPage)}
      description={`Every card in Sorcery: Contested Realm - ${registry.header.cards.toLocaleString('en')} of them, alphabetically.`}>
  <p class="eyebrow">Browse the archive</p><h1>All cards</h1>
  <p class="intro">Every card the registry holds, alphabetically. Looking for something in particular? <a href="/search">Search</a> or <a href="/advanced">build a query</a>.</p>
  <p class="muted">{registry.header.cards.toLocaleString('en')} cards · showing {page.start + 1}–{page.end + 1} · page {page.currentPage} of {page.lastPage}</p>

  <nav class="az" aria-label="Jump to a letter">
    {letters.map(([letter, n]) => <a href={`${href(n)}#top`} aria-current={letter >= firstOnPage && letter <= lastOnPage ? 'true' : undefined}>{letter}</a>)}
  </nav>

  <div class="grid">{page.data.map(card => <CardTile card={card} printing={printingOf(card)} />)}</div>

  <nav class="pager" aria-label="Pages">
    <a class:list={['btn', 'secondary', { disabled: !page.url.prev }]} href={page.url.prev ?? href(1)} rel="prev">← Previous</a>
    <span class="muted">Page {page.currentPage} of {page.lastPage}</span>
    <a class:list={['btn', 'secondary', { disabled: !page.url.next }]} href={page.url.next ?? href(page.lastPage)} rel="next">Next →</a>
  </nav>
</Base>
