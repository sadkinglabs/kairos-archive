---
import Base from '../../../layouts/Base.astro';
import CardArt from '../../../components/CardArt.astro';
import FaceFacts from '../../../components/FaceFacts.astro';
import RecordActions from '../../../components/RecordActions.astro';
import PrintingEntry from '../../../components/PrintingEntry.astro';
import CardHistory from '../../../components/CardHistory.astro';
import { cardPath, loadRegistry, officialCardUrl, slugify, views } from '../../../data/registry';
export async function getStaticPaths() {
  const { registry } = await loadRegistry();
  return registry.cards.map(card => ({ params: { id: card.codex_id, slug: slugify(card.name) }, props: { card } }));
}
const { card } = Astro.props;
const { registry } = await loadRegistry();
const v = views(registry);
const printings = [...(v.printingsByCard.get(card.codex_id) ?? [])].sort((a, b) => a.printing_id.localeCompare(b.printing_id));
const defaultPrinting = printings.find(p => p.printing_id === card.default_printing_id) ?? printings[0] ?? null;
const history = v.historyByCard.get(card.codex_id) ?? [];
const names = v.namesByCard.get(card.codex_id) ?? [];
const official = officialCardUrl(defaultPrinting);
---
<Base title={card.name} canonical={cardPath(card)} description={`${card.type ?? ''} · ${card.rules_text.slice(0, 140)}`} image={card.image_urls?.normal ?? null}>
  <div class="card-overview">
    <div class="card-heading"><p class="eyebrow">The card archive</p><h1>{card.name} {card.errata && <span class="badge errata">Errata</span>}</h1><p class="intro">{[card.rarity, card.type, ...card.subtypes, ...card.elements].filter(Boolean).join(' · ')}</p></div>
    <div class="art-column"><CardArt urls={card.image_urls} status={card.image_status} name={card.name} type={card.type} />{defaultPrinting?.back && <CardArt urls={defaultPrinting.back.image_urls} status={defaultPrinting.image_status} name={`${card.name}, back face`} type={card.back?.type} back />}</div>
    <div class="card-content">
      <FaceFacts face={card} />
      <section id="rules"><h2>Current rules</h2>
        {card.errata && <div class="errata-notice"><span>{defaultPrinting?.printed_as_current === false ? 'This printing shows earlier values.' : 'This card has recorded errata.'}</span><a href="#history">See history →</a></div>}
        <pre class="rules">{card.rules_text || 'No rules text'}</pre>
      </section>
      {card.back && <section><h2>Back face · current rules</h2><p class="muted">{[card.back.type, ...card.back.subtypes].filter(Boolean).join(' · ')}</p><pre class="rules">{card.back.rules_text || 'No rules text'}</pre><FaceFacts face={card.back} /></section>}
      <RecordActions id={card.codex_id} url={card.api_url} official={official} />
      <nav class="section-links" aria-label="On this card"><a href="#printings">{printings.length} printings ↓</a><a href="#history">History ↓</a><a href="/docs/cards">Data documentation</a></nav>
    </div>
  </div>
  <section id="printings" class="page-section"><div class="section-heading"><h2>Printings</h2><span class="muted">{printings.length} archived</span></div><p class="muted">Each set, product and finish has a permanent printing ID.</p>
    <div class="printing-list">{printings.map(p => <PrintingEntry printing={p} card={card} history={history} names={names} />)}</div>
  </section>
  <section id="history" class="page-section"><h2>Card history</h2><CardHistory rows={history} names={names} /></section>
</Base>
