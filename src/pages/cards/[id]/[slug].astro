---
import Base from '../../../layouts/Base.astro';
import CardArt from '../../../components/CardArt.astro';
import FaceBox from '../../../components/FaceBox.astro';
import RecordActions from '../../../components/RecordActions.astro';
import PrintingEntry from '../../../components/PrintingEntry.astro';
import CardHistory from '../../../components/CardHistory.astro';
import { cardPath, loadRegistry, slugify, views } from '../../../data/registry';
import { officialCardUrl, officialSlugFromName } from '../../../presentation/officialCardUrl';
export async function getStaticPaths() {
  const { registry } = await loadRegistry();
  // Two ways of naming the publisher's page for a card: read their spelling
  // out of their slugs, or derive it from the card name. The links use the
  // first; the second is here to disagree. Both are right for all 1,100
  // cards in this release, so a release where they part means their
  // normalisation changed or a slug stopped parsing - which would ship a
  // page of 404s, and fails the build instead.
  const slugsFor = new Map<string, string[]>();
  for (const printing of registry.printings) {
    slugsFor.set(printing.codex_id, [...(slugsFor.get(printing.codex_id) ?? []), printing.slug]);
  }
  const parted = registry.cards.filter(card => {
    const read = officialCardUrl(slugsFor.get(card.codex_id) ?? []);
    return read !== null && !read.endsWith(`/${officialSlugFromName(card.name)}`);
  });
  if (parted.length > 0) {
    throw new Error(`The publisher's card slug no longer matches their name for ${parted.length} card(s): ` +
      parted.slice(0, 5).map(c => `${c.name} (${c.codex_id})`).join(', ') +
      '. Check sorcerytcg.com and update officialSlugFromName, or the links will 404.');
  }
  return registry.cards.map(card => ({
    params: { id: card.codex_id, slug: slugify(card.name) },
    props: { card, officialUrl: officialCardUrl(slugsFor.get(card.codex_id) ?? []) },
  }));
}
const { card, officialUrl } = Astro.props;
const { registry } = await loadRegistry();
const v = views(registry);
const printings = [...(v.printingsByCard.get(card.codex_id) ?? [])].sort((a, b) => a.printing_id.localeCompare(b.printing_id));
const defaultPrinting = printings.find(p => p.printing_id === card.default_printing_id) ?? printings[0] ?? null;
const history = v.historyByCard.get(card.codex_id) ?? [];
const names = v.namesByCard.get(card.codex_id) ?? [];

---
<Base title={card.name} canonical={cardPath(card)} description={`${card.type ?? ''} · ${card.rules_text.slice(0, 140)}`} image={card.image_urls?.normal ?? null}>
  <div class="card-overview">
    <div class="art-column"><CardArt urls={card.image_urls} status={card.image_status} name={card.name} type={card.type} />{defaultPrinting?.back && <CardArt urls={defaultPrinting.back.image_urls} status={defaultPrinting.image_status} name={`${card.name}, back face`} type={card.back?.type} back />}</div>
    <div class="card-content">
      <FaceBox face={card} title={card.name} level={1} printing={defaultPrinting} errata={card.errata}
        erratumNote={card.errata ? (defaultPrinting?.printed_as_current === false ? 'This printing shows earlier values.' : 'This card has recorded errata.') : null} />
      {card.back && <details class="face-disclosure">
        <summary><span class="label">Back face</span><span class="muted">{[card.back.type, ...card.back.subtypes].filter(Boolean).join(' · ')}</span></summary>
        <FaceBox face={card.back} printing={defaultPrinting?.back ?? null} />
      </details>}
      <RecordActions id={card.codex_id} url={card.api_url} official={officialUrl} />
      <nav class="section-links" aria-label="On this card"><a href="#printings">{printings.length} printings ↓</a><a href="#history">History ↓</a><a href="/docs/cards">Data documentation</a></nav>
    </div>
  </div>
  <section id="printings" class="page-section"><div class="section-heading"><h2>Printings</h2><span class="muted">{printings.length} archived</span></div><p class="muted">Each set, product and finish has a permanent printing ID.</p>
    <div class="printing-list">{printings.map(p => <PrintingEntry printing={p} card={card} history={history} names={names} />)}</div>
  </section>
  <section id="history" class="page-section"><h2>Card history</h2><CardHistory rows={history} names={names} /></section>
</Base>
