---
import Base from '../layouts/Base.astro';
import SearchBox from '../components/SearchBox.astro';
import Icon from '../components/Icon.astro';
import { loadRegistry } from '../data/registry';
import { KEYS, IS_FLAGS, UNITS } from '../search/keys';
const { registry } = await loadRegistry();
const example = (key: string) => KEYS.find(k => k.name === key)!.examples[0];
const examples = [
  { label: 'Water minions', query: `${example('type')} ${example('element')}` },
  { label: 'Foil printings', query: `${example('finish')} unique:${UNITS.find(u => u === 'prints')}` },
  { label: 'Cards with errata', query: `is:${IS_FLAGS.find(f => f.name === 'errata')!.name}` },
];
const entries = [
  { icon: 'sets', title: 'Browse sets', detail: 'Explore every release, card and printing.', href: '/sets' },
  { icon: 'history', title: 'Changes and Errata', detail: 'See what changed. Read what came before.', href: '/changes' },
  { icon: 'code', title: 'Read the documentation', detail: 'API guides, stable identifiers and open data.', href: '/docs' },
];
---
<Base title="Kairos Archive" canonical="/">
  <div class="home">
    <section class="hero" aria-labelledby="home-heading">
      {/* The front door says what this is in one sentence, the way the card
          search people already know does: the name, the game, and the thing
          that makes it different - the record, not only the search. */}
      <h1 id="home-heading" class="statement"><strong>Kairos Archive</strong> is a powerful <strong>Sorcery: Contested Realm</strong> card search, and a rigorous record of the realm.</h1>
      <SearchBox hero />
      <nav class="hero-links" aria-label="Ways in">
        <a class="btn secondary" href="/advanced">Advanced Search</a>
        <a class="btn secondary" href="/syntax">Search Syntax</a>
        <a class="btn secondary" href="/sets">All Sets</a>
        <a class="btn secondary" href="/cards">All Cards</a>
        <a class="btn secondary" href="/random">Random Card</a>
      </nav>
      <div class="try-search"><p class="eyebrow muted">Try a search</p><div class="example-chips">{examples.map(e => <a href={`/search?q=${encodeURIComponent(e.query)}`}>{e.label}</a>)}</div></div>
    </section>
    <section class="explore" aria-labelledby="explore-heading">
      <h2 id="explore-heading">Explore the archive</h2>
      {entries.map(e => <a class="explore-row" href={e.href}><Icon name={e.icon} size={29} /><span><strong>{e.title}</strong><span class="muted">{e.detail}</span></span><Icon /></a>)}
    </section>
    <p class="archive-counts">{registry.header.cards.toLocaleString('en')} cards <span>·</span> {registry.header.printings.toLocaleString('en')} printings <span>·</span> {registry.header.sets} sets</p>
  </div>
</Base>
